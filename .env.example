# Copia este archivo a .env y ajusta los valores. .env NUNCA debe subirse
# a un repositorio público (agrégalo a .gitignore).

# --- General ---
APP_NAME="Coffee Market Intelligence"
ENVIRONMENT=development
DEBUG=true

# --- Base de datos ---
# SQLite (por defecto, cero configuración):
DATABASE_URL=sqlite:///./data/coffee_market.db
# PostgreSQL en producción, ejemplo:
# DATABASE_URL=postgresql+psycopg2://usuario:password@host:5432/coffee_market

# --- Mercado internacional (Yahoo Finance — NO requiere API key) ---
INTERNATIONAL_ARABICA_TICKER=KC=F
# Ver README: no se confirmó un ticker gratuito "continuo" confiable para
# robusta al construir esta app. Ajusta este valor si encuentras uno mejor.
INTERNATIONAL_ROBUSTA_TICKER=RM=F
INTERNATIONAL_PROVIDER_TIMEOUT_SECONDS=6

# --- Alpha Vantage (opcional; respaldo de commodities, no usado por defecto) ---
# Clave gratuita en: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# --- TRM / Banco de la República ---
# Banco de la República migró de portal durante 2026 (ver README). Verifica
# este endpoint contra https://www.banrep.gov.co/es/estadisticas/trm antes
# de asumir que sigue vigente.
TRM_OPEN_DATA_URL=https://www.datos.gov.co/resource/32sa-8pi3.json
CURRENCY_PROVIDER_TIMEOUT_SECONDS=6

# --- Precio nacional (Federación Nacional de Cafeteros) ---
# La FNC publica el precio interno de referencia como boletín, no como API
# JSON estable (ver README). Esta URL es best-effort y puede requerir
# actualización periódica.
FNC_BULLETIN_URL=https://federaciondecafeteros.org/estadisticas-cafeteras/
# Diferencial educativo (centavos USD/lb) — NO se usa para calcular un
# precio "oficial", solo queda disponible para análisis exploratorio propio
# si decides extenderlo. Ver docstring de app/core/config.py.
COLOMBIA_PRICE_DIFFERENTIAL_USD_CENTS_PER_LB=8.0

# --- Caché ---
PRICE_CACHE_MINUTES=15

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
